# Safe workstation template. Copy to .env.local; never commit real values.
# Placeholders allow build/layout work; they do not provide working auth/data.
# Replace BOTH Supabase public values with the isolated beta project's values
# for real login. See SETUP.md. Never substitute production credentials.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-beta-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://blbd.webflow.io

BLBD_ADMIN_ENVIRONMENT=beta
BLBD_BETA_SUPABASE_PROJECT_REF=hfmjvbjyectxiszutwen
# Server-only; leave blank for design work. Supplied separately if needed.
SUPABASE_SERVICE_ROLE_KEY=

# Sending stays OFF locally; shared beta may have sending enabled.
BLBD_ADMIN_MAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL="BLBD Beta <contact@blbd.life>"
BLBD_MAIL_POSTAL_ADDRESS=
SUPABASE_AUTH_EMAIL_HOOK_SECRET=

# Optional services, not needed for workstation setup.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SUPPORTER=
STRIPE_PRICE_MEMBER=
STRIPE_PRICE_FOUNDING=
WEBFLOW_API_TOKEN=
WEBFLOW_BLOG_COLLECTION_ID=

# Keep unconfigured providers and historical Webflow admin transport disabled.
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=false
NEXT_PUBLIC_ENABLE_FACEBOOK_OAUTH=false
BLBD_WEBFLOW_ADMIN_ORIGIN=
